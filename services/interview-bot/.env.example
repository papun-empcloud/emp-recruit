# --- What to run ---
# The emp-recruit AI-interview token (create a session in the app: AI Interviews
# -> New AI Interview -> the candidate link is /ai-interview/<TOKEN>).
AI_INTERVIEW_TOKEN=
# The Jitsi room to join (the scheduled interview's "Join Room" URL).
JITSI_ROOM_URL=https://meet.jit.si/emprecruit-xxxxxxxx
# Where the emp-recruit API is reachable from the bot host.
RECRUIT_API_BASE=http://host.docker.internal:4500/api/v1

# --- Speech-to-text (required) ---
DEEPGRAM_API_KEY=
DEEPGRAM_ENDPOINTING_MS=1500
DEEPGRAM_UTTERANCE_END_MS=2000

# --- Text-to-speech ---
# "espeak" (offline, bundled in the Docker image). Swap for a cloud voice by
# implementing a provider in src/tts.ts.
TTS_ENGINE=espeak
TTS_VOICE=en-us
TTS_WPM=150

# --- Runtime ---
BOT_DISPLAY_NAME=AI Interviewer
CHROMIUM_PATH=/usr/bin/chromium
# Answer capture bounds (ms)
MIN_ANSWER_MS=2000
MAX_ANSWER_MS=90000
